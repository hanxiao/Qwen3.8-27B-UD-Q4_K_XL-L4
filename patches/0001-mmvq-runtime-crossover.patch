 #include "unary.cuh"
 #include "vecdotq.cuh"
@@ -280,6 +281,15 @@ int get_mmvq_mmid_max_batch(ggml_type type, int cc) {
 }
 
 bool ggml_cuda_should_use_mmvq(enum ggml_type type, int cc, int64_t ne11) {
+    // GGML_MMVQ_MAX: override the MMVQ batch ceiling at runtime (default MMVQ_MAX_BATCH_SIZE).
+    // Setting it below 8 pushes those batch widths onto MMQ (int8 tensor cores) instead.
+    static const int64_t mmvq_max_env = []() -> int64_t {
+        const char * s = getenv("GGML_MMVQ_MAX");
+        return s ? atoll(s) : (int64_t) MMVQ_MAX_BATCH_SIZE;
+    }();
+    if (ne11 > mmvq_max_env) {
+        return false;
+    }
     if (!ggml_is_quantized(type)) {
         return false;
     }
