@@ -280,6 +281,38 @@ int get_mmvq_mmid_max_batch(ggml_type type, int cc) {
 }
 
 bool ggml_cuda_should_use_mmvq(enum ggml_type type, int cc, int64_t ne11) {
+    // GGML_MMVQ_MAX: override the MMVQ batch ceiling at runtime (default MMVQ_MAX_BATCH_SIZE).
+    // Setting it below 8 pushes those batch widths onto MMQ (int8 tensor cores) instead.
+    // Per-quant-type crossover. The file is a mix of types and the MMQ admission cost is not
+    // necessarily uniform across them, so allow each to be routed independently:
+    //   GGML_MMVQ_MAX        global default
+    //   GGML_MMVQ_MAX_Q5K / _Q4K / _Q6K / _IQ4XS   per-type override
+    struct mmvq_thresholds {
+        int64_t def, q5k, q4k, q6k, iq4xs;
+        static int64_t get(const char * name, int64_t fallback) {
+            const char * s = getenv(name);
+            return s ? atoll(s) : fallback;
+        }
+        mmvq_thresholds() {
+            def   = get("GGML_MMVQ_MAX", (int64_t) MMVQ_MAX_BATCH_SIZE);
+            q5k   = get("GGML_MMVQ_MAX_Q5K",   def);
+            q4k   = get("GGML_MMVQ_MAX_Q4K",   def);
+            q6k   = get("GGML_MMVQ_MAX_Q6K",   def);
+            iq4xs = get("GGML_MMVQ_MAX_IQ4XS", def);
+        }
+    };
+    static const mmvq_thresholds th;
+    int64_t lim = th.def;
+    switch (type) {
+        case GGML_TYPE_Q5_K:   lim = th.q5k;   break;
+        case GGML_TYPE_Q4_K:   lim = th.q4k;   break;
+        case GGML_TYPE_Q6_K:   lim = th.q6k;   break;
+        case GGML_TYPE_IQ4_XS: lim = th.iq4xs; break;
+        default: break;
+    }
+    if (ne11 > lim) {
+        return false;
+    }
     if (!ggml_is_quantized(type)) {
         return false;
     }
